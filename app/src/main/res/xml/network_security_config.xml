<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.foxtrader.io</domain>
        <domain includeSubdomains="true">stream.binance.com</domain>
        <domain includeSubdomains="true">api.bybit.com</domain>
        <domain includeSubdomains="true">www.alphavantage.co</domain>
        <domain includeSubdomains="true">api.twelvedata.com</domain>
    </domain-config>
    <!-- Debug builds may still use cleartext for localhost emulator testing. -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
