<?xml version="1.0" encoding="utf-8"?>
<!--
    Data-extraction rules (API 31+): excludes sensitive local storage from BOTH
    cloud backup and device-to-device transfer.

    The Room database (foxtrader.db + its -wal / -shm side files) holds
    user-authored trade records, chart drawings, alerts and watchlists. It is
    excluded so private trading data is never copied off-device in plaintext,
    whether to cloud backup or to a transferred device.

    EncryptedSharedPreferences files (fox_auth_tokens.xml, fox_provider_keys.xml, fox_deriv_credentials.xml)
    are also excluded: the Keystore master key does not travel with a backup, so
    restoring undecryptable ciphertext would otherwise throw during prefs init.
    The app defensively recovers by wiping and recreating an empty store, but
    excluding these files is the primary safety measure.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="foxtrader.db" />
        <exclude domain="database" path="foxtrader.db-wal" />
        <exclude domain="database" path="foxtrader.db-shm" />
        <exclude domain="sharedpref" path="fox_auth_tokens.xml" />
        <exclude domain="sharedpref" path="fox_provider_keys.xml" />
    <exclude domain="sharedpref" path="fox_deriv_credentials.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="foxtrader.db" />
        <exclude domain="database" path="foxtrader.db-wal" />
        <exclude domain="database" path="foxtrader.db-shm" />
        <exclude domain="sharedpref" path="fox_auth_tokens.xml" />
        <exclude domain="sharedpref" path="fox_provider_keys.xml" />
    <exclude domain="sharedpref" path="fox_deriv_credentials.xml" />
    </device-transfer>
</data-extraction-rules>
