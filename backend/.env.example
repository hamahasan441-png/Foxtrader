# FoxTrader backend configuration (copy to .env for local overrides).

# Candle source: "sample" (offline synthetic, default) or "twelvedata" (real).
FOX_PROVIDER=sample

# Required when FOX_PROVIDER=twelvedata (https://twelvedata.com/).
FOX_TWELVEDATA_API_KEY=

# Comma-separated CORS allow-list. "*" is fine for local development.
FOX_CORS_ORIGINS=*

FOX_APP_NAME=FoxTrader Market Data API
FOX_VERSION=0.1.0
