# FoxTrader backend configuration (copy to .env for local overrides).

# Generic backend candle source: sample | twelvedata | polygon | allratestoday
# The Android AllRatesToday provider also has dedicated proxy routes and does
# not require this global provider to be changed.
FOX_PROVIDER=sample

# Server-side provider credentials. NEVER put these values in the Android app,
# BuildConfig, source control, logs, or a public container image.
FOX_TWELVE_DATA_KEY=
FOX_POLYGON_KEY=
ART_API_KEY=

# Comma-separated CORS allow-list. Defaults to http://localhost; only use "*"
# when you intentionally want any cross-origin site to call this API.
FOX_CORS_ORIGINS=http://localhost

# Auth/sync persistence backend: "sqlite" (durable, default) or "memory".
FOX_STORE=sqlite
FOX_DB_PATH=foxtrader.db

# Auth/sync + market rate limiting (per client IP).
FOX_RATE_LIMIT_ENABLED=true
FOX_RATE_LIMIT_AUTH_PER_WINDOW=20
FOX_RATE_LIMIT_WINDOW_SECONDS=60
FOX_RATE_LIMIT_MARKET_PER_WINDOW=120
FOX_RATE_LIMIT_MARKET_WINDOW_SECONDS=60
FOX_TRUSTED_PROXIES=

FOX_APP_NAME=FoxTrader Market Data API
FOX_VERSION=0.1.0
